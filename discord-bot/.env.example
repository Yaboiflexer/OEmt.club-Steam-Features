# Copy this file to .env and fill it in. Never commit .env.

# Developer Portal > OEmt.club Update > Bot > Reset Token
DISCORD_TOKEN=

# Right-click the updates channel > Copy Channel ID (turn on Developer Mode in Discord settings first)
CHANNEL_ID=

# Optional: role to ping on every update (right-click role > Copy Role ID). Leave empty for no ping.
PING_ROLE_ID=

# How often to check Steam, in minutes
POLL_MINUTES=10
