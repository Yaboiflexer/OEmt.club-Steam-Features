{
  "name": "oemt-update-bot",
  "version": "0.1.0",
  "private": true,
  "description": "OEmt.club Update: posts SteamDB-style Steam record updates for tracked games to a Discord channel",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "once": "node index.js --once",
    "dry": "node index.js --dry",
    "add-game": "node add-game.js",
    "stats": "node schedule-stats.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "steam-user": "^5.3.0"
  }
}
